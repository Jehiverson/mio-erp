rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(storeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.active == true;
    }
    match /stores/{storeId}/members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /stores/{storeId}/products/{productId} {
      allow get, list: if member(storeId);
      // Todas las mutaciones pasan por funciones autenticadas con transacción.
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
