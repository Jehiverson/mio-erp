ENABLE_QWENCLOUD=false
# Activar sólo en la siguiente fase de IA.
FUNCTIONS_REGION=us-central1
PRODUCT_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
QWENCLOUD_REGION=ap-southeast-1
QWENCLOUD_MODEL=qwen3-vl-plus
# QWENCLOUD_API_KEY es un secreto: firebase functions:secrets:set QWENCLOUD_API_KEY --project YOUR_PROJECT_ID
# En emuladores, usar .secret.local (ignorado por Git). No poner claves en VITE_.
